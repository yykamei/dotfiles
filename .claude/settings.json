{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(rm:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(tee:*)",
      "Bash(uniq:*)",
      "Bash(xargs:*)",
      "Bash(mkdir -p ~/.worktrees/*)",
      "Read(~/.config/opencode/**)",
      "Read(~/.plannotator/**)",
      "Read(~/.claude/**)",
      "Read(~/.worktrees/**)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Edit(//tmp/**)",
      "Edit(//private/tmp/**)",
      "Edit(~/.worktrees/**)",
      "mcp__sentry__*",
      "mcp__plugin_datadog_mcp__*"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.config/opencode",
      "~/.worktrees",
      "/tmp"
    ]
  },
  "enabledPlugins": {
    "datadog@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "ruby-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      },
      "autoUpdate": true
    }
  },
  "theme": "light"
}
