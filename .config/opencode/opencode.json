{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "opencode-go/deepseek-v4.1-flash",
  "experimental": {
    "subagent_depth": 2
  },
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "skills": [
    "~/.config/opencode/vendor/hallmark/skills"
  ],
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/var/folders/*/*/T/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.worktrees/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.rbenv/versions/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.opencode/plan/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.pbi/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/git/Private/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/git/Private/dotfiles/**", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "ask" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "ask" },
    { "action": "read", "resource": "*.key", "effect": "ask" },
    { "action": "read", "resource": "id_*", "effect": "ask" },
    { "action": "read", "resource": "*.npmrc", "effect": "ask" },
    { "action": "read", "resource": "*.netrc", "effect": "ask" },
    { "action": "read", "resource": "*.tfstate", "effect": "ask" },
    { "action": "read", "resource": "*kubeconfig*", "effect": "ask" },
    { "action": "read", "resource": "**/secrets/**", "effect": "ask" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "ask" },
    { "action": "read", "resource": "**/.aws/**", "effect": "ask" },
    { "action": "edit", "resource": "/tmp/**", "effect": "allow" },
    { "action": "edit", "resource": "/private/tmp/**", "effect": "allow" },
    { "action": "edit", "resource": "~/.worktrees/**", "effect": "allow" },
    { "action": "edit", "resource": "~/.rbenv/versions/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.cache/**", "effect": "allow" },
    { "action": "edit", "resource": "~/.pbi/**", "effect": "allow" },
    { "action": "edit", "resource": "~/git/Private/**", "effect": "ask" },
    { "action": "edit", "resource": "~/git/Private/**/.git/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/opencode/**", "effect": "ask" }
  ]
}
