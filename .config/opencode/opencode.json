{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@plannotator/opencode@latest"
  ],
  "update": "disable",
  "model": "opencode-go/deepseek-v4.1-flash",
  "experimental": {
    "subagent_depth": 2
  },
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "skills": [
    "~/.config/opencode/vendor/hallmark/skills"
  ],
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.worktrees/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.rbenv/versions/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.pbi/**", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/**", "effect": "allow" },
    { "action": "edit", "resource": "/private/tmp/**", "effect": "allow" },
    { "action": "edit", "resource": "~/.worktrees/**", "effect": "allow" },
    { "action": "edit", "resource": "~/.rbenv/versions/**", "effect": "deny" },
    { "action": "edit", "resource": "~/.cache/**", "effect": "allow" },
    { "action": "edit", "resource": "~/.pbi/**", "effect": "allow" }
  ]
}
